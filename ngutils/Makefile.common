# =============================================================================
# Shared build rules for ngutils/* subprojects.
#
# Each project's Makefile sets PROJNAME and includes this file.
# To override file lists (for multi-file projects), set SRC_LIST,
# TEST_SRC_LIST, or SRC_HDR *before* including this file.
# =============================================================================

# ── GNU Make version guard ──────────────────────────────────────────────────
MAKE_VERSION_MAJOR := $(firstword $(subst ., ,$(MAKE_VERSION)))
MAKE_VERSION_MINOR := $(word 2,$(subst ., ,$(MAKE_VERSION)))

ifeq ($(MAKE_VERSION_MAJOR),3)
  ifneq ($(shell test $(MAKE_VERSION_MINOR) -ge 81 && echo ok),ok)
    $(error GNU Make 3.81 or newer required; found $(MAKE_VERSION))
  endif
else ifneq ($(shell test $(MAKE_VERSION_MAJOR) -ge 4 && echo ok),ok)
  $(error GNU Make 3.81 or newer required; found $(MAKE_VERSION))
endif

ifeq ($(PROJNAME),)
$(error PROJNAME is not set — define it before including Makefile.common)
endif

# ── Toolchain & Flags ───────────────────────────────────────────────────────
CC          ?= cc
CFLAGS      += -Wall -Wextra -Werror -std=gnu11 -Iinclude
CFLAGS      += -DTEST_PROJNAME=\"$(PROJNAME)\"

CRIT_CFLAGS ?= $(shell pkg-config --cflags criterion 2>/dev/null)
CRIT_LIBS   ?= $(shell pkg-config --libs   criterion 2>/dev/null)
HAVE_CRITERION := $(shell pkg-config --exists criterion 2>/dev/null && echo yes)
REQUIRE_CRITERION ?= 0

CLANG_TIDY  ?= clang-tidy
SCAN_BUILD  ?= scan-build
MAKEFLAGS   += --no-print-directory

# ── Sanitizers ──────────────────────────────────────────────────────────────
SANITIZE ?=

ifeq ($(SANITIZE),asan)
  SAN_CC_FLAGS = -fsanitize=address,undefined -fno-omit-frame-pointer
  SAN_RUN      =
else ifeq ($(SANITIZE),lsan)
  SAN_CC_FLAGS = -fsanitize=address -fno-omit-frame-pointer
  SAN_RUN      = ASAN_OPTIONS=detect_leaks=1
else
  SAN_CC_FLAGS =
  SAN_RUN      =
endif
CFLAGS += $(SAN_CC_FLAGS)

# ── Cross-utility dependencies ──────────────────────────────────────────────
REQUIRES     ?=
REQ_INCLUDES  = $(addprefix -I../,$(addsuffix /include,$(REQUIRES)))
CFLAGS       += $(REQ_INCLUDES)

# ── Layout & Paths ──────────────────────────────────────────────────────────
BUILD_DIR    ?= build
DEBUG         = $(BUILD_DIR)/debug
RELEASE       = $(BUILD_DIR)/release
DBG_OBJ       = $(DEBUG)/obj
REL_OBJ       = $(RELEASE)/obj

DBG_CFLAGS    = -g -O0
REL_CFLAGS    = -O2 -DNDEBUG

REQ_ARCHIVES  = $(foreach req,$(REQUIRES),../$(req)/$(BUILD_DIR)/debug/lib$(req).a)

# ── File Lists (Explicit) ───────────────────────────────────────────────────
# Defaults assume one source/header/test file matching PROJNAME.
# Override these in the project Makefile if you have more.
SRC_LIST      ?= src/$(PROJNAME).c
TEST_SRC_LIST ?= test/test_$(PROJNAME).c
SRC_HDR       ?= include/$(PROJNAME).h

# Derived object lists
OBJ_LIST      = $(patsubst src/%.c,$(DBG_OBJ)/%.o,$(SRC_LIST))
TEST_OBJ_LIST = $(patsubst test/%.c,$(DBG_OBJ)/test_%.o,$(TEST_SRC_LIST))
REL_OBJ_LIST  = $(patsubst src/%.c,$(REL_OBJ)/%.o,$(SRC_LIST))

LIB           = $(DEBUG)/lib$(PROJNAME).a
REL_LIB       = $(RELEASE)/lib$(PROJNAME).a
TEST_BIN      = $(DEBUG)/test_$(PROJNAME)

DEPFILES      = $(OBJ_LIST:.o=.d) $(TEST_OBJ_LIST:.o=.d) $(REL_OBJ_LIST:.o=.d)

.PHONY: all lib librelease test check analyze analyze-lib analyze-test \
        asan_check asan_leak clean list arch-logs clean-log-archive \
        clean-logs-$(PROJNAME) FORCE

# ── Default Target ──────────────────────────────────────────────────────────
all:
	@$(MAKE) lib
	@$(MAKE) test
	@$(MAKE) librelease

# ── Build Rules ─────────────────────────────────────────────────────────────

# Debug Library
lib: $(LIB)
$(LIB): $(OBJ_LIST) | $(DEBUG)
	@ar rcs $@ $^
	@echo "Built: $@"

# Release Library
librelease: $(REL_LIB)
$(REL_LIB): $(REL_OBJ_LIST) | $(RELEASE)
	@ar rcs $@ $^
	@echo "Built: $@"

# Compilation rules (static pattern)
$(OBJ_LIST): $(DBG_OBJ)/%.o: src/%.c $(SRC_HDR) | $(DBG_OBJ)
	$(CC) $(CFLAGS) $(DBG_CFLAGS) -MMD -MP -c $< -o $@

$(TEST_OBJ_LIST): $(DBG_OBJ)/test_%.o: test/%.c $(SRC_HDR) | $(DBG_OBJ)
	$(CC) $(CFLAGS) $(CRIT_CFLAGS) $(DBG_CFLAGS) -MMD -MP -c $< -o $@

$(REL_OBJ_LIST): $(REL_OBJ)/%.o: src/%.c $(SRC_HDR) | $(REL_OBJ)
	$(CC) $(CFLAGS) $(REL_CFLAGS) -MMD -MP -c $< -o $@

# Directory creation
$(DBG_OBJ) $(REL_OBJ) $(DEBUG) $(RELEASE):
	@mkdir -p $@

# ── Testing & Logging ───────────────────────────────────────────────────────
TEST_LOG ?= 1

LOG_ARCHIVE_DIR   = logs/archive
LOG_ARCHIVE_TS   := $(shell date +%Y%m%d_%H%M%S)
LOG_ARCHIVE_FILE  = $(LOG_ARCHIVE_DIR)/$(PROJNAME)_$(LOG_ARCHIVE_TS).log.gz

# ── Log targets — unconditional, safe to call any time ────────────────────
#
#   make merge-logs-fs2    — fold raw logs into logs/result/all.log
#                            (idempotent; usable after a failed test run)
#   make clean-logs-fs2    — archive previous all.log, wipe raw logs
#
# Both defined OUTSIDE the HAVE_CRITERION branch: diagnostics should work
# even on a machine without Criterion (last logs still worth merging).

.PHONY: merge-logs-$(PROJNAME)

merge-logs-$(PROJNAME):
	@mkdir -p logs/result
	@find logs -maxdepth 1 -name 'test_$(PROJNAME)_*.log' \
	    -exec cat {} + > logs/result/all.log 2>/dev/null || true
	@find logs -maxdepth 1 -name 'test_$(PROJNAME)_*.log' \
	    -delete 2>/dev/null || true
	@echo "Merged: logs/result/all.log"

clean-logs-$(PROJNAME): arch-logs
	@find logs -maxdepth 1 -name 'test_$(PROJNAME)_*.log' \
	    -delete 2>/dev/null || true
	@rm -rf logs/result

# ── Test target — structural ifeq, shell for the rest ─────────────────────

ifeq ($(HAVE_CRITERION),yes)

test: clean-logs-$(PROJNAME) $(TEST_BIN)
	@$(SAN_RUN) $(TEST_BIN); status=$$?; \
	 if [ "$(TEST_LOG)" = "1" ]; then \
	    $(MAKE) --no-print-directory merge-logs-$(PROJNAME); \
	 fi; \
	 exit $$status

$(TEST_BIN): $(OBJ_LIST) $(TEST_OBJ_LIST) $(REQ_ARCHIVES) | $(DEBUG)
	$(CC) $(SAN_CC_FLAGS) -o $@ $^ $(CRIT_LIBS)

else

test:
	@if [ "$(REQUIRE_CRITERION)" = "1" ]; then \
	    echo "ERROR: Criterion not found, REQUIRE_CRITERION=1" >&2; \
	    exit 1; \
	 fi; \
	 echo "SKIP: Criterion not installed (pkg-config --exists criterion failed)"; \
	 echo "      Install with: brew install criterion   (macOS)"; \
	 echo "                    apt install libcriterion-dev  (Debian/Ubuntu)"

endif

# Log Archiving & Cleaning
arch-logs:
	@if [ -s logs/result/all.log ]; then \
	    mkdir -p $(LOG_ARCHIVE_DIR); \
	    gzip -c logs/result/all.log > $(LOG_ARCHIVE_FILE); \
	    echo "Archived: $(LOG_ARCHIVE_FILE)"; \
	fi

clean-log-archive:
	@rm -rf $(LOG_ARCHIVE_DIR)
	@echo "Removed: $(LOG_ARCHIVE_DIR)"

# ── Analysis ────────────────────────────────────────────────────────────────
check:
	$(CLANG_TIDY) $(SRC_LIST) $(TEST_SRC_LIST) -- $(CFLAGS) $(CRIT_CFLAGS)

analyze: analyze-lib
analyze-lib:
	@mkdir -p $(BUILD_DIR)/analyze
	@rm -rf $(DEBUG)
	@$(SCAN_BUILD) --status-bugs -o $(BUILD_DIR)/analyze \
	    $(MAKE) lib

analyze-test:
	@mkdir -p $(BUILD_DIR)/analyze-test
	@rm -rf $(DEBUG)
	@$(SCAN_BUILD) --status-bugs -o $(BUILD_DIR)/analyze-test \
	    $(MAKE) $(TEST_BIN)

# ── Sanitizers ──────────────────────────────────────────────────────────────
asan_check:
	@echo "==> asan_check $(PROJNAME): ASan + UBSan"
	@$(MAKE) clean test BUILD_DIR=build/asan-ubsan SANITIZE=asan

asan_leak:
	@if [ "$$(uname)" = "Darwin" ]; then \
	    echo "SKIP: LeakSanitizer not available on macOS."; \
	    echo "      Use 'make test-docker-leak' (Linux container)."; \
	else \
	    echo "==> asan_leak $(PROJNAME): ASan + LSan"; \
	    $(MAKE) clean test BUILD_DIR=build/asan-lsan SANITIZE=lsan; \
	fi

# ── Misc / Cleanup ──────────────────────────────────────────────────────────
clean:
	@find $(BUILD_DIR) -mindepth 1 -exec rm -rf {} + 2>/dev/null || true
	@rmdir $(BUILD_DIR) 2>/dev/null || true

list:
	@echo "Targets:"
	@grep -hE '^[a-zA-Z][a-zA-Z0-9_-]*:' $(MAKEFILE_LIST) | sed 's/:.*//' | sort -u | sed 's/^/  /'

# ── Cross-project Dependencies ──────────────────────────────────────────────
FORCE:

define REQ_RULE
../$(1)/$(BUILD_DIR)/debug/lib$(1).a: FORCE
	@$$(MAKE) -C ../$(1) lib BUILD_DIR=$$(BUILD_DIR) SANITIZE=$$(SANITIZE)
endef

$(foreach req,$(REQUIRES),$(eval $(call REQ_RULE,$(req))))

-include $(DEPFILES)

