# Shared build rules for ngutils/* subprojects.
#
# Each project's Makefile sets PROJNAME and includes this file:
#
#     PROJNAME = bool
#     include ../Makefile.common
#
# Optional, for projects that depend on siblings:
#
#     PROJNAME = error
#     REQUIRES = log bool
#     include ../Makefile.common

# ── GNU Make version guard ──────────────────────────────────────────────────
#
# 4.0+ is required: earlier versions have unreliable $(eval) inside
# $(foreach), different handling of multiline define/call, and no
# $(file ...). Apple's shipped Make 3.81 fails on our REQ_RULE and
# docker-test-recipe patterns.
#
# macOS users with Homebrew:
#     brew install make
#     export PATH="/opt/homebrew/opt/make/libexec/gnubin:$PATH"

MAKE_VERSION_MAJOR := $(firstword $(subst ., ,$(MAKE_VERSION)))

ifeq ($(shell test "$(MAKE_VERSION_MAJOR)" -lt 4 && echo old),old)
$(error GNU Make 4.0 or newer required; found $(MAKE_VERSION). \
        On macOS: brew install make, then add \
        /opt/homebrew/opt/make/libexec/gnubin to PATH)
endif

ifeq ($(PROJNAME),)
$(error PROJNAME is not set — define it before including Makefile.common)
endif

# --- toolchain & flags ---

CC          ?= cc
CFLAGS      += -Wall -Wextra -std=gnu11 -Iinclude

# Stringified project name for test_common.h (test_setup uses it to
# build the log path). Quoting: the shell sees \" which it converts
# to a literal " before passing to the compiler.
CFLAGS += -DTEST_PROJNAME=\"$(PROJNAME)\"

# ── Sanitizers ──────────────────────────────────────────────────────────────
#
#   SANITIZE=asan    ASan + UBSan.  macOS and Linux.
#   SANITIZE=lsan    ASan + LSan.   Linux only (LeakSanitizer).
#
# SANITIZE and BUILD_DIR must reach sub-makes as make arguments
# (VAR=value before the goal), not as environment assignments. A
# parent make already has BUILD_DIR=build from ?=, and passing an env
# var would be shadowed by the parse-time value.

SANITIZE ?=

ifeq ($(SANITIZE),asan)
  SAN_CC_FLAGS = -fsanitize=address,undefined -fno-omit-frame-pointer
  SAN_RUN      =
else ifeq ($(SANITIZE),lsan)
  SAN_CC_FLAGS = -fsanitize=address -fno-omit-frame-pointer
  SAN_RUN      = ASAN_OPTIONS=detect_leaks=1
else
  SAN_CC_FLAGS =
  SAN_RUN      =
endif

CFLAGS += $(SAN_CC_FLAGS)

CRIT_CFLAGS ?= $(shell pkg-config --cflags criterion 2>/dev/null)
CRIT_LIBS   ?= $(shell pkg-config --libs   criterion 2>/dev/null)

HAVE_CRITERION := $(shell pkg-config --exists criterion 2>/dev/null && echo yes)
REQUIRE_CRITERION ?= 0

CLANG_TIDY  ?= clang-tidy
SCAN_BUILD  ?= scan-build

MAKEFLAGS   += --no-print-directory

# --- cross-utility dependencies ---

REQUIRES     ?=
REQ_INCLUDES  = $(addprefix -I../,$(addsuffix /include,$(REQUIRES)))

CFLAGS       += $(REQ_INCLUDES)

# --- layout ---

BUILD_DIR    ?= build
DEBUG         = $(BUILD_DIR)/debug
RELEASE       = $(BUILD_DIR)/release
DBG_OBJ       = $(DEBUG)/obj
REL_OBJ       = $(RELEASE)/obj

REQ_ARCHIVES = $(foreach req,$(REQUIRES),../$(req)/$(BUILD_DIR)/debug/lib$(req).a)

DBG_CFLAGS    = -g -O0
REL_CFLAGS    = -O2 -DNDEBUG

SRC           = $(wildcard src/*.c)
TEST_SRC      = test/test_$(PROJNAME).c
SRC_HDR       = include/$(PROJNAME).h

SRC_OBJ       = $(patsubst src/%.c,$(DBG_OBJ)/%.o,$(SRC))
TEST_OBJ      = $(DBG_OBJ)/test_$(PROJNAME).o
TEST_BIN      = $(DEBUG)/test_$(PROJNAME)
LIB           = $(DEBUG)/lib$(PROJNAME).a

REL_SRC_OBJ   = $(patsubst src/%.c,$(REL_OBJ)/%.o,$(SRC))
REL_LIB       = $(RELEASE)/lib$(PROJNAME).a

DEPFILES      = $(SRC_OBJ:.o=.d) $(TEST_OBJ:.o=.d) $(REL_SRC_OBJ:.o=.d)

.PHONY: all lib librelease test check clean list \
        analyze analyze-lib analyze-test \
        asan_check asan_leak FORCE clean-logs-$(PROJNAME)

# --- default ---

all:
	@$(MAKE) lib
	@$(MAKE) test
	@$(MAKE) librelease

# --- debug lib ---

lib: $(LIB)

$(LIB): $(SRC_OBJ) | $(DEBUG)
	@ar rcs $@ $^
	@echo "Built: $@"

$(DBG_OBJ)/%.o: src/%.c $(SRC_HDR) | $(DBG_OBJ)
	$(CC) $(CFLAGS) $(DBG_CFLAGS) -MMD -MP -c $< -o $@

# --- test ---
TEST_LOG ?= 1

ifeq ($(HAVE_CRITERION),yes)

test: clean-logs-$(PROJNAME) $(TEST_BIN)
ifeq ($(TEST_LOG),1)
	@mkdir -p logs/result
endif
	@$(SAN_RUN) $(TEST_BIN)
ifeq ($(TEST_LOG),1)
	@find logs -maxdepth 1 -name 'test_$(PROJNAME)_*.log' \
		-exec cat {} + > logs/result/all.log
	@find logs -maxdepth 1 -name 'test_$(PROJNAME)_*.log' -delete
	echo "Merged: logs/result/all.log"
endif

clean-logs-$(PROJNAME):
	@rm -f logs/test_$(PROJNAME)*.log
	@rm -rf logs/result

$(TEST_BIN): $(SRC_OBJ) $(TEST_OBJ) $(REQ_ARCHIVES) | $(DEBUG)
	$(CC) $(SAN_CC_FLAGS) -o $@ $^ $(CRIT_LIBS)

$(TEST_OBJ): $(TEST_SRC) $(SRC_HDR) | $(DBG_OBJ)
	$(CC) $(CFLAGS) $(CRIT_CFLAGS) $(DBG_CFLAGS) -MMD -MP -c $< -o $@

else

test:
ifeq ($(REQUIRE_CRITERION),1)
	@echo "ERROR: Criterion not found, REQUIRE_CRITERION=1" >&2
	@exit 1
else
	@echo "SKIP: Criterion not installed (pkg-config --exists criterion failed)"
	@echo "      Install with: brew install criterion  (macOS)"
	@echo "                    apt install libcriterion-dev  (Debian/Ubuntu)"
endif

endif

# --- release lib ---

librelease: $(REL_LIB)

$(REL_LIB): $(REL_SRC_OBJ) | $(RELEASE)
	@ar rcs $@ $^
	@echo "Built: $@"

$(REL_OBJ)/%.o: src/%.c $(SRC_HDR) | $(REL_OBJ)
	$(CC) $(CFLAGS) $(REL_CFLAGS) -MMD -MP -c $< -o $@

# --- dirs ---

$(DBG_OBJ) $(REL_OBJ) $(DEBUG) $(RELEASE):
	@mkdir -p $@

# --- analysis ---

check:
	$(CLANG_TIDY) $(SRC) $(TEST_SRC) -- $(CFLAGS) $(CRIT_CFLAGS)

analyze: analyze-lib

analyze-lib:
	@mkdir -p $(BUILD_DIR)/analyze
	@rm -rf $(DEBUG)
	@$(SCAN_BUILD) --status-bugs -o $(BUILD_DIR)/analyze \
	    $(MAKE) lib

analyze-test:
	@mkdir -p $(BUILD_DIR)/analyze-test
	@rm -rf $(DEBUG)
	@$(SCAN_BUILD) --status-bugs -o $(BUILD_DIR)/analyze-test \
	    $(MAKE) $(TEST_BIN)

# --- sanitizers ---
#
# BUILD_DIR and SANITIZE are passed as make arguments, not env
# assignments. This ensures $(TEST_BIN) etc. resolve against the
# sanitizer build tree, and that the value survives $(MAKE) recursion.

asan_check:
	@echo "==> asan_check $(PROJNAME): ASan + UBSan"
	@$(MAKE) clean test BUILD_DIR=build/asan-ubsan SANITIZE=asan

asan_leak:
	@if [ "$$(uname)" = "Darwin" ]; then \
	    echo "SKIP: LeakSanitizer not available on macOS."; \
	    echo "      Use 'make test-docker-leak' (Linux container)."; \
	else \
	    echo "==> asan_leak $(PROJNAME): ASan + LSan"; \
	    $(MAKE) clean test BUILD_DIR=build/asan-lsan SANITIZE=lsan; \
	fi

# --- misc ---

clean:
	@find $(BUILD_DIR) -mindepth 1 -exec rm -rf {} + 2>/dev/null || true
	@rmdir $(BUILD_DIR) 2>/dev/null || true

list:
	@echo "Targets:"
	@grep -hE '^[a-zA-Z][a-zA-Z0-9_-]*:' $(MAKEFILE_LIST) | sed 's/:.*//' | sort -u | sed 's/^/  /'

# --- cross-project archives ---

FORCE:

define REQ_RULE
../$(1)/$(BUILD_DIR)/debug/lib$(1).a: FORCE
	@$$(MAKE) -C ../$(1) lib BUILD_DIR=$$(BUILD_DIR) SANITIZE=$$(SANITIZE)
endef

$(foreach req,$(REQUIRES),$(eval $(call REQ_RULE,$(req))))

-include $(DEPFILES)

