# Shared build rules for ngutils/* subprojects.
#
# Each project's Makefile sets PROJNAME and includes this file:
#
#     PROJNAME = bool
#     include ../Makefile.common
#
# Optional, for projects that depend on siblings:
#
#     PROJNAME = error
#     REQUIRES = log bool
#     include ../Makefile.common

ifeq ($(PROJNAME),)
$(error PROJNAME is not set — define it before including Makefile.common)
endif

# --- toolchain & flags ---

CC          ?= cc
CFLAGS      += -Wall -Wextra -std=gnu11 -Iinclude

# ── Sanitizers & leak checking ──────────────────────────────────────────────
#
#   SANITIZE=asan    ASan + UBSan. Works on macOS and Linux.
#                    On Linux, LeakSanitizer is built into ASan.
#   SANITIZE=lsan    ASan + explicit leak detection (Linux only).
#
# Convenience targets:
#   make asan_check   ASan + UBSan, isolated under build/asan/
#   make asan_leak    ASan + LSan  (SKIP on macOS)
#   make leaks_check  Apple `leaks --atExit` (SKIP on Linux)
#
# SANITIZE and BUILD_DIR are exported to sub-makes for dependency
# rebuilds — every archive must be built with the same sanitizer set,
# otherwise ASan's interceptors miss part of the process.

SANITIZE ?=

ifeq ($(SANITIZE),asan)
  SAN_CC_FLAGS = -fsanitize=address,undefined -fno-omit-frame-pointer
  SAN_RUN      =
else ifeq ($(SANITIZE),lsan)
  SAN_CC_FLAGS = -fsanitize=address -fno-omit-frame-pointer
  SAN_RUN      = ASAN_OPTIONS=detect_leaks=1
else
  SAN_CC_FLAGS =
  SAN_RUN      =
endif

CFLAGS += $(SAN_CC_FLAGS)

CRIT_CFLAGS ?= $(shell pkg-config --cflags criterion 2>/dev/null)
CRIT_LIBS   ?= $(shell pkg-config --libs   criterion 2>/dev/null)

HAVE_CRITERION := $(shell pkg-config --exists criterion 2>/dev/null && echo yes)
REQUIRE_CRITERION ?= 0

CLANG_TIDY  ?= clang-tidy
SCAN_BUILD  ?= scan-build

MAKEFLAGS   += --no-print-directory

# --- cross-utility dependencies ---
#
# REQUIRES lists sibling utilities this project depends on. Each name
# adds -I../<name>/include to CFLAGS and ../<name>/build/debug/lib<name>.a
# to link dependencies.

REQUIRES     ?=
REQ_INCLUDES  = $(addprefix -I../,$(addsuffix /include,$(REQUIRES)))

#REQ_ARCHIVES  = $(foreach req,$(REQUIRES),../$(req)/build/debug/lib$(req).a)
# instead that one

# Paths of required sibling archives, for linking.
REQ_ARCHIVES = $(foreach req,$(REQUIRES),../$(req)/$(BUILD_DIR)/debug/lib$(req).a)

# One explicit rule per requirement — no $(dir $@)/../.. path walking,
# which fails when build/asan/debug does not exist yet.
define REQ_RULE
../$(1)/$(BUILD_DIR)/debug/lib$(1).a:
	@$$(MAKE) -C ../$(1) lib BUILD_DIR=$$(BUILD_DIR) SANITIZE=$$(SANITIZE)
endef

$(foreach req,$(REQUIRES),$(eval $(call REQ_RULE,$(req))))

CFLAGS       += $(REQ_INCLUDES)

# Build required archives on demand via sub-make.
# Generate one explicit rule per requirement, so the project path is
# known directly and we never rely on path-walking through `..`.
define REQ_RULE
../$(1)/build/debug/lib$(1).a:
	@$$(MAKE) -C ../$(1) lib
endef

$(foreach req,$(REQUIRES),$(eval $(call REQ_RULE,$(req))))

# --- layout ---

BUILD_DIR    ?= build
DEBUG         = $(BUILD_DIR)/debug
RELEASE       = $(BUILD_DIR)/release
DBG_OBJ       = $(DEBUG)/obj
REL_OBJ       = $(RELEASE)/obj

DBG_CFLAGS    = -g -O0
REL_CFLAGS    = -O2 -DNDEBUG

SRC           = $(wildcard src/*.c)
TEST_SRC      = test/test_$(PROJNAME).c
SRC_HDR       = include/$(PROJNAME).h

SRC_OBJ       = $(patsubst src/%.c,$(DBG_OBJ)/%.o,$(SRC))
TEST_OBJ      = $(DBG_OBJ)/test_$(PROJNAME).o
TEST_BIN      = $(DEBUG)/test_$(PROJNAME)
LIB           = $(DEBUG)/lib$(PROJNAME).a

REL_SRC_OBJ   = $(patsubst src/%.c,$(REL_OBJ)/%.o,$(SRC))
REL_LIB       = $(RELEASE)/lib$(PROJNAME).a

DEPFILES      = $(SRC_OBJ:.o=.d) $(TEST_OBJ:.o=.d) $(REL_SRC_OBJ:.o=.d)

.PHONY: all lib librelease test check clean list analyze analyze-lib analyze-test

# --- default ---

all:
	@$(MAKE) lib
	@$(MAKE) test
	@$(MAKE) librelease

# --- debug lib ---

lib: $(LIB)

$(LIB): $(SRC_OBJ) | $(DEBUG)
	@ar rcs $@ $^
	@echo "Built: $@"

$(DBG_OBJ)/%.o: src/%.c $(SRC_HDR) | $(DBG_OBJ)
	$(CC) $(CFLAGS) $(DBG_CFLAGS) -MMD -MP -c $< -o $@

# --- test ---

ifeq ($(HAVE_CRITERION),yes)

test: $(TEST_BIN)
	@$(SAN_RUN) @$(TEST_BIN)

$(TEST_BIN): $(SRC_OBJ) $(TEST_OBJ) $(REQ_ARCHIVES) | $(DEBUG)
	$(CC)  $(SAN_CC_FLAGS) -o $@ $^ $(CRIT_LIBS)

$(TEST_OBJ): $(TEST_SRC) $(SRC_HDR) | $(DBG_OBJ)
	$(CC) $(CFLAGS) $(CRIT_CFLAGS) $(DBG_CFLAGS) -MMD -MP -c $< -o $@

else

test:
ifeq ($(REQUIRE_CRITERION),1)
	@echo "ERROR: Criterion not found, REQUIRE_CRITERION=1" >&2
	@exit 1
else
	@echo "SKIP: Criterion not installed (pkg-config --exists criterion failed)"
	@echo "      Install with: brew install criterion  (macOS)"
	@echo "                    apt install libcriterion-dev  (Debian/Ubuntu)"
endif

endif

# --- release lib ---

librelease: $(REL_LIB)

$(REL_LIB): $(REL_SRC_OBJ) | $(RELEASE)
	@ar rcs $@ $^
	@echo "Built: $@"

$(REL_OBJ)/%.o: src/%.c $(SRC_HDR) | $(REL_OBJ)
	$(CC) $(CFLAGS) $(REL_CFLAGS) -MMD -MP -c $< -o $@

# --- dirs ---

$(DBG_OBJ) $(REL_OBJ) $(DEBUG) $(RELEASE):
	@mkdir -p $@

# --- analysis ---

check:
	$(CLANG_TIDY) $(SRC) $(TEST_SRC) -- $(CFLAGS) $(CRIT_CFLAGS)

# Analyze the library sources with clang static analyzer.
analyze: analyze-lib

analyze-lib:
	@mkdir -p $(BUILD_DIR)/analyze
	@rm -rf $(DEBUG)
	@$(SCAN_BUILD) --status-bugs -o $(BUILD_DIR)/analyze \
	    $(MAKE) lib

# Analyze tests as well (slower, noisier — Criterion macros)
analyze-test:
	@mkdir -p $(BUILD_DIR)/analyze-test
	@rm -rf $(DEBUG)
	@$(SCAN_BUILD) --status-bugs -o $(BUILD_DIR)/analyze-test \
		$(MAKE) $(TEST_BIN)

# --- misc ---

clean:
	@find $(BUILD_DIR) -mindepth 1 -exec rm -rf {} + 2>/dev/null || true
	@rm -rf build/asan

clean-logs:
	@rm -f logs/*.log

list:
	@echo "Targets:"
	@grep -hE '^[a-zA-Z][a-zA-Z0-9_-]*:' $(MAKEFILE_LIST) | sed 's/:.*//' | sort -u | sed 's/^/  /'

.PHONY: asan_check asan_leak leaks_check

# ASan + UBSan. Isolated BUILD_DIR so the normal build/ is untouched.
asan_check:
	@echo "==> asan_check $(PROJNAME): ASan + UBSan"
	@SANITIZE=asan BUILD_DIR=build/asan \
	    $(MAKE) clean test

# Linux only: ASan + LSan. --no-fork so leaks inside Criterion's
# per-test children are actually seen by the parent LSan runtime.
asan_leak:
	@if [ "$$(uname)" = "Darwin" ]; then \
	    echo "SKIP: LeakSanitizer not available on macOS."; \
	    echo "      Use a Linux box or 'make test-docker'."; \
	else \
	    echo "==> asan_leak $(PROJNAME): ASan + LSan"; \
	    SANITIZE=lsan BUILD_DIR=build/asan $(MAKE) clean; \
	    SANITIZE=lsan BUILD_DIR=build/asan \
	        ASAN_OPTIONS=detect_leaks=1 $(MAKE) $(TEST_BIN); \
	    ASAN_OPTIONS=detect_leaks=1 ./$(TEST_BIN); \
	fi

# macOS only: Apple's `leaks` tool. Requires a non-ASan build, so
# sanitizer flags are stripped from CFLAGS for this run.
leaks_check:
	@if [ "$$(uname)" != "Darwin" ]; then \
	    echo "SKIP: Apple leaks tool is macOS-only. Use make asan_leak."; \
	else \
	    echo "==> leaks_check $(PROJNAME): leaks --atExit"; \
	    $(MAKE) clean; \
	    $(MAKE) test CFLAGS="$(CFLAGS_LEAK) -g -O0"; \
	    MallocStackLogging=1 leaks --atExit -- ./$(TEST_BIN); \
	fi

# CFLAGS with sanitizer flags (and -MD/-MP) stripped, for leaks_check.
CFLAGS_LEAK = $(filter-out -fsanitize=% -fno-omit-frame-pointer -MD -MP,$(CFLAGS))

-include $(DEPFILES)

